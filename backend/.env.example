# Copy this file to .env and add your Gemini API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Langfuse is required for agent tracing and system prompts.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PROMPT_LABEL=production

# Optional Grafana Cloud OTLP metrics. Copy these values from the stack's
# OpenTelemetry setup. Keep the authorization header secret.
OTEL_SERVICE_NAME=codegradingagent-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=

# Local RabbitMQ defaults. Change these to match your RabbitMQ installation.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F
SUBMISSION_UPLOAD_QUEUE=submission_uploads
CORS_ORIGINS=http://localhost:5173

# Authentication. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=
AUTH_SESSION_MAX_AGE=1209600
AUTH_COOKIE_SECURE=false

# Optional Google OAuth. Configure the redirect URI as
# http://localhost:8000/auth/google/callback in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_URL=http://localhost:5173
